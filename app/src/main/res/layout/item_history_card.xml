<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivHistoryThumb"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_rounded_card"
            android:contentDescription="History Leaf"
            android:scaleType="centerCrop"
            android:src="@drawable/crop_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHistoryDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oct 20, 2026 • 15:30"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvHistoryDiseaseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Early Blight"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistoryCropAndScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tomato • 65% Confidence"
                android:textColor="@color/primary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDeleteHistoryItem"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete"
            android:src="@drawable/ic_warning"
            app:tint="@color/text_tertiary" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
